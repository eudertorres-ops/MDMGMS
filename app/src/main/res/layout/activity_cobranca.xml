<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assinatura obrigatória do termo"
            android:textColor="#1E3A8A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtModelo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtTermo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#F1F5F9"
            android:padding="14dp"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <!-- 1) Identificação por CPF -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Digite seu CPF para identificar-se"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <EditText
            android:id="@+id/editCpf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Somente números"
            android:inputType="number"
            android:maxLength="11"
            android:autofillHints="" />

        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Buscar meus dados"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />

        <!-- 2) Dados encontrados -->
        <LinearLayout
            android:id="@+id/grupoResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:background="#F8FAFC">

            <TextView
                android:id="@+id/txtNomeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtSetorInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 2a) Assinatura armazenada (reaproveitar) -->
        <LinearLayout
            android:id="@+id/grupoReuso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sua assinatura registrada:"
                android:textColor="#0F172A"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgAssinatura"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="6dp"
                android:background="#F8FAFC"
                android:scaleType="fitCenter"
                android:contentDescription="Assinatura" />

            <Button
                android:id="@+id/btnAssinarManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prefiro assinar agora"
                style="?android:attr/buttonBarButtonStyle" />
        </LinearLayout>

        <!-- 2b) Assinatura manual (desenhar) -->
        <LinearLayout
            android:id="@+id/grupoManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/lblNomeManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome completo"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:visibility="gone" />

            <EditText
                android:id="@+id/editNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Seu nome completo"
                android:inputType="textPersonName|textCapWords"
                android:autofillHints="name"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Assine abaixo com o dedo"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <br.com.controller.agent.SignaturePadView
                android:id="@+id/signaturePad"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="6dp"
                android:background="#F8FAFC" />

            <Button
                android:id="@+id/btnLimpar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limpar assinatura"
                style="?android:attr/buttonBarButtonStyle" />
        </LinearLayout>

        <!-- 3) Confirmar -->
        <Button
            android:id="@+id/btnConfirmar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Confirmar e assinar termo"
            android:backgroundTint="#16A34A"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Este aparelho é corporativo e gerenciado pela empresa. A assinatura do termo é obrigatória."
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
